# Parser configuration. Both bookmaker parsers run by default.

# --- Olimp (olimpbet.kz) ---
OLIMP_ENABLED=1
# OLIMP_BASE_URL=https://olimpbet.kz

# --- 1xbet ---
# NOTE: 1xbet geo-blocks data-center IPs (requests -> /en/block). Run from an
# allowed region/residential IP, or point at a working mirror.
ONEXBET_ENABLED=1
# ONEXBET_BASE_URL=https://1xbet.com

# --- App ---
# Show demo data when both bookmakers return nothing (e.g. blocked IP):
DEMO_FALLBACK=0
# REFRESH_SECONDS=20
# DEFAULT_STAKE=1000

# --- Bet automation ---
# Master kill-switch. Nothing is ever placed while this is 0.
BETTING_ENABLED=0
# "paper" (simulate, default & safe) or "real" (place via your session).
BETTING_MODE=paper
# Risk guard rails:
BETTING_MIN_PROFIT=0.5
BETTING_MAX_STAKE=5000
# For BETTING_MODE=real you MUST provide an authenticated session per book and
# implement <Book>Executor._submit. Real placement violates bookmaker ToS, can
# get accounts banned, and a partial fill leaves an unhedged position.
# OLIMP_SESSION=
# ONEXBET_SESSION=
