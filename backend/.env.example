# Copy to .env to enable real-bookmaker data via The Odds API.
# Get a free key at https://the-odds-api.com

# Without this key the app runs on the demo parser only.
THE_ODDS_API_KEY=

# Optional tuning:
# THE_ODDS_API_REGIONS=eu          # eu | uk | us | au (comma-separated)
# THE_ODDS_API_SPORTS=soccer_epl,tennis_atp,basketball_nba
# REFRESH_SECONDS=20               # background refresh interval
# DEFAULT_STAKE=1000               # default bankroll for stake split
