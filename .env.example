# Copy to .env (or set in your shell) to configure the scanner.

# --- Server ---
PORT=3000
SCAN_MS=5000
DEFAULT_STAKE=10000
MIN_DISPLAY_PROFIT=0

# --- 1xBet (geo-blocks data-center IPs; run from an allowed region) ---
ONEXBET_BASE_URL=https://1xbet.kz
# ONEXBET_PARTNER=159
# ONEXBET_MAX_GAMES=12
# HEADLESS=new            # run the scraping browser headless

# --- Olimp ---
OLIMP_BASE_URL=https://olimpbet.kz

# --- Bet automation ---
BETTING_MODE=paper        # paper (safe, default) | real
BETTING_MIN_PROFIT=0.5
BETTING_MAX_STAKE=5000

# Dev only: simulate the 1xBet feed from Olimp data to demo the pipeline.
# DEV_FAKE_XBET=1
